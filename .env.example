# Copy this file to .env.local and adjust as needed.

# Optional live services feed, read at build time. Leave empty to use
# src/data/services.fallback.json (the default).
SERVICES_API_URL=

# Where "Request Service" sends the client. {id} {name} {state} {message} are filled in.
# Default: WhatsApp chat with the request pre-filled. Set to empty to show an "opening soon" message.
NEXT_PUBLIC_START_REQUEST_URL=https://wa.me/916300347380?text={message}

# WhatsApp number used by "Talk to Expert" and Support (country code + number, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=916300347380

# Marketing site the logo links to.
NEXT_PUBLIC_HOME_URL=https://www.charteredone.com

# Set to "false" to hide sample user / requests / notifications (like the live site does today).
NEXT_PUBLIC_SHOW_SAMPLE_DATA=true
